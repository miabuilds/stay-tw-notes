# 全站安全標頭（点击劫持・MIME sniffing・referrer 漏洩を防ぐ）
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(self), payment=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Cloudflare Pages 快取策略
# HTML は必ず再検証（古い index.html がキャッシュされて「記事が旧 Web Speech のまま」になるのを防ぐ）
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
# 音檔檔名 = 內容 hash → 可以放心永久快取（改內容檔名就變）
/audio/tts/*
  Cache-Control: public, max-age=31536000, immutable
/audio/manifest.json
  Cache-Control: public, max-age=300
/images/*
  Cache-Control: public, max-age=86400
