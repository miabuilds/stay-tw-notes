[{"序號": "1", "語法點": "繫動詞", "等別": "基礎", "級別": "第1級", "例句": "我是學生。"}, {"序號": "2", "語法點": "表所有「的」", "等別": "基礎", "級別": "第1級", "例句": "這是爸爸的鞋子。"}, {"序號": "3", "語法點": "「的」省略用法", "等別": "基礎", "級別": "第1級", "例句": "我_媽媽。"}, {"序號": "4", "語法點": "不", "等別": "基礎", "級別": "第1級", "例句": "A：你是學生嗎？B：我不是（學生）。"}, {"序號": "5", "語法點": "這/那/哪", "等別": "基礎", "級別": "第1級", "例句": "1. 這是什麼？2. 那是誰？3. 你是哪國人？"}, {"序號": "6", "語法點": "什麼", "等別": "基礎", "級別": "第1級", "例句": "你愛吃什麼？這是什麼？"}, {"序號": "7", "語法點": "嗎", "等別": "基礎", "級別": "第1級", "例句": "你喜歡喝咖啡嗎？"}, {"序號": "8", "語法點": "在1", "等別": "基礎", "級別": "第1*級", "例句": "他在學校。"}, {"序號": "9", "語法點": "地點表達", "等別": "基礎", "級別": "第1*級", "例句": "臺灣臺中中山北路123號"}, {"序號": "10", "語法點": "時間表達", "等別": "基礎", "級別": "第1*級", "例句": "他的生日是一九九五年六月十三日。現在是下午兩點三十分。"}, {"序號": "11", "語法點": "稱數法 ", "等別": "基礎", "級別": "第1*級", "例句": "2   二39  三十九108 一百零八110 一百一（十）1,000 一千1,018 一千零一十八10,000 一萬10,890 一萬零八百九十"}, {"序號": "12", "語法點": "數+量", "等別": "基礎", "級別": "第1*級", "例句": "一本書一個人"}, {"序號": "13", "語法點": "誰", "等別": "基礎", "級別": "第1*級", "例句": "你喜歡誰？誰在教室？"}, {"序號": "14", "語法點": "哪（裡/兒）", "等別": "基礎", "級別": "第1*級", "例句": "郵局在哪（裡/兒）？"}, {"序號": "15", "語法點": "A-not-A", "等別": "基礎", "級別": "第1*級", "例句": "你喜歡不喜歡喝咖啡？"}, {"序號": "16", "語法點": "Vs（的）N", "等別": "基礎", "級別": "第2級", "例句": "這是一部很好看的電影。"}, {"序號": "17", "語法點": "V了1", "等別": "基礎", "級別": "第2級", "例句": "我昨天買了很多書。"}, {"序號": "18", "語法點": "和1", "等別": "基礎", "級別": "第2級", "例句": "這間餐廳的點心很棒，大人和小孩都喜歡。"}, {"序號": "19", "語法點": "沒（有）1", "等別": "基礎", "級別": "第2級", "例句": "圖書館附近沒有公園。我沒錢。"}, {"序號": "20", "語法點": "會1", "等別": "基礎", "級別": "第2級", "例句": "你今年會出國嗎？"}, {"序號": "21", "語法點": "V著1", "等別": "基礎", "級別": "第2級", "例句": "他戴著帽子。"}, {"序號": "22", "語法點": "序數", "等別": "基礎", "級別": "第2級", "例句": "這是我第一次來臺灣。"}, {"序號": "23", "語法點": "如果", "等別": "基礎", "級別": "第2級", "例句": "如果下雨，我就不出門。"}, {"序號": "24", "語法點": "可以1", "等別": "基礎", "級別": "第2級", "例句": "上課不可以吃東西。"}, {"序號": "25", "語法點": "要2", "等別": "基礎", "級別": "第2級", "例句": "你要記得打電話給王老師。"}, {"序號": "26", "語法點": "要3", "等別": "基礎", "級別": "第2級", "例句": "你今天要一起吃飯嗎？"}, {"序號": "27", "語法點": "時量補語", "等別": "基礎", "級別": "第2級", "例句": "他已經來臺灣一個月了。"}, {"序號": "28", "語法點": "但是", "等別": "基礎", "級別": "第2級", "例句": "這個箱子很大，但是裡面的東西很輕。"}, {"序號": "29", "語法點": "能1", "等別": "基礎", "級別": "第2級", "例句": "他的車能坐七個人。"}, {"序號": "30", "語法點": "V過1", "等別": "基礎", "級別": "第2級", "例句": "我看過這部電影。"}, {"序號": "31", "語法點": "就1", "等別": "基礎", "級別": "第2級", "例句": "你回到家就給我打電話。"}, {"序號": "32", "語法點": "「的」後接成分省略", "等別": "基礎", "級別": "第2級", "例句": "A：你喜歡藍色外套還是黑色外套？B：我喜歡藍的。"}, {"序號": "33", "語法點": "會2", "等別": "基礎", "級別": "第2級", "例句": "你會不會開車？"}, {"序號": "34", "語法點": "能2", "等別": "基礎", "級別": "第2級", "例句": "他感冒了，今天不能運動。"}, {"序號": "35", "語法點": "要1", "等別": "基礎", "級別": "第2級", "例句": "我要出去了，你有什麼話快一點說吧。"}, {"序號": "36", "語法點": "賓+被+V", "等別": "基礎", "級別": "第2級", "例句": "盒子被打開了。"}, {"序號": "37", "語法點": "V+Vs", "等別": "基礎", "級別": "第2級", "例句": "你吃飽了嗎？"}, {"序號": "38", "語法點": "跟2", "等別": "基礎", "級別": "第2級", "例句": "他跟我說了一個很有意思的故事。"}, {"序號": "39", "語法點": "想", "等別": "基礎", "級別": "第2級", "例句": "妹妹想吃冰淇淋。"}, {"序號": "40", "語法點": "和2", "等別": "基礎", "級別": "第2級", "例句": "妹妹很喜歡和爸爸聊天。"}, {"序號": "41", "語法點": "從1", "等別": "基礎", "級別": "第2級", "例句": "我從法國來。"}, {"序號": "42", "語法點": "用", "等別": "基礎", "級別": "第2級", "例句": "他會用筷子吃飯。"}, {"序號": "43", "語法點": "在2/正在V", "等別": "基礎", "級別": "第2級", "例句": "學生在踢足球。媽媽正在包餃子。"}, {"序號": "44", "語法點": "呢1", "等別": "基礎", "級別": "第2級", "例句": "他是德國人，你呢？"}, {"序號": "45", "語法點": "（雖然），可是", "等別": "基礎", "級別": "第2級", "例句": "雖然他不是很有錢，可是他很快樂。我想出國玩，可是錢不夠。"}, {"序號": "46", "語法點": "N+們", "等別": "基礎", "級別": "第2級", "例句": "孩子們都在外面玩。"}, {"序號": "47", "語法點": "開始V", "等別": "基礎", "級別": "第2級", "例句": "我們十點開始上課。"}, {"序號": "48", "語法點": "怎麼", "等別": "基礎", "級別": "第2級", "例句": "從這裡到車站怎麼走？"}, {"序號": "49", "語法點": "可以2", "等別": "基礎", "級別": "第2級", "例句": "你可以看懂中文菜單嗎？"}, {"序號": "50", "語法點": "為什麼", "等別": "基礎", "級別": "第2級", "例句": "你為什麼吃不下飯？"}, {"序號": "51", "語法點": "給", "等別": "基礎", "級別": "第2級", "例句": "他給我一本書。"}, {"序號": "52", "語法點": "V見", "等別": "基礎", "級別": "第2級", "例句": "我看見李明華的腳踏車在樓下。"}, {"序號": "53", "語法點": "V了2", "等別": "基礎", "級別": "第2級", "例句": "天氣變了。天氣冷了。"}, {"序號": "54", "語法點": "（請）不要", "等別": "基礎", "級別": "第2級", "例句": "請不要說話！"}, {"序號": "55", "語法點": "數字+幾", "等別": "基礎", "級別": "第2級", "例句": "這條路上有十幾間餐廳。"}, {"序號": "56", "語法點": "請", "等別": "基礎", "級別": "第2級", "例句": "請你走過來。"}, {"序號": "57", "語法點": "V得+補語", "等別": "基礎", "級別": "第2級", "例句": "王美美的中文字寫得很漂亮。衣服洗得很乾淨。"}, {"序號": "58", "語法點": "幫", "等別": "基礎", "級別": "第2級", "例句": "你可以幫我去郵局寄信嗎？"}, {"序號": "59", "語法點": "以前", "等別": "基礎", "級別": "第2級", "例句": "我以前在醫院工作過。他常常睡覺以前看書。"}, {"序號": "60", "語法點": "V出1", "等別": "基礎", "級別": "第2級", "例句": "王美美一走出餐廳就看見室友。"}, {"序號": "61", "語法點": "多/少", "等別": "基礎", "級別": "第2級", "例句": "你可以多吃一點水果。哥哥應該少喝點啤酒。"}, {"序號": "62", "語法點": "也", "等別": "基礎", "級別": "第2*級", "例句": "他會說中文，也會說日文。"}, {"序號": "63", "語法點": "在3", "等別": "基礎", "級別": "第2*級", "例句": "他在聖誕節的時候去美國。"}, {"序號": "64", "語法點": "以後", "等別": "基礎", "級別": "第2*級", "例句": "吃完早餐以後，他就去上學了。兩個月以後我要去日本。"}, {"序號": "65", "語法點": "怎麼樣", "等別": "基礎", "級別": "第2*級", "例句": "今天天氣怎麼樣？"}, {"序號": "66", "語法點": "幾/多少1", "等別": "基礎", "級別": "第2*級", "例句": "從臺北到臺中，坐火車要幾個小時？啤酒一罐多少錢？"}, {"序號": "67", "語法點": "怎麼辦", "等別": "基礎", "級別": "第2*級", "例句": "我今天忘了帶錢，怎麼辦？"}, {"序號": "68", "語法點": "跟1", "等別": "基礎", "級別": "第2*級", "例句": "我跟姐姐一起到圖書館借書。"}, {"序號": "69", "語法點": "請問", "等別": "基礎", "級別": "第2*級", "例句": "請問你叫什麼名字？"}, {"序號": "70", "語法點": "好嗎", "等別": "基礎", "級別": "第2*級", "例句": "請你再說一次，好嗎？"}, {"序號": "71", "語法點": "怎麼了", "等別": "基礎", "級別": "第2*級", "例句": "李明華今天沒來上班，他怎麼了？"}, {"序號": "72", "語法點": "V到2/在", "等別": "基礎", "級別": "第2*級", "例句": "阿姨走到對面的超市去買菜。叔叔一直住在臺北。"}, {"序號": "73", "語法點": "從......到......1", "等別": "基礎", "級別": "第2*級", "例句": "這間公司的上班時間是從早上八點到下午五點。"}, {"序號": "74", "語法點": "從......到......2", "等別": "基礎", "級別": "第2*級", "例句": "從臺北到南投開車要三個半小時。"}, {"序號": "75", "語法點": "都1", "等別": "基礎", "級別": "第2*級", "例句": "我們都喜歡慢跑。"}, {"序號": "76", "語法點": "V來/去1", "等別": "基礎", "級別": "第2*級", "例句": "你的東西我拿來了。他跑去學校了。"}, {"序號": "77", "語法點": "因為......所以......", "等別": "基礎", "級別": "第2*級", "例句": "因為他們沒有錢，所以不能出國旅行。"}, {"序號": "78", "語法點": "有的......有的......", "等別": "基礎", "級別": "第2*級", "例句": "班上的同學有的會說英文，有的會說法文。"}, {"序號": "79", "語法點": "到......（去/來）+VP", "等別": "基礎", "級別": "第2*級", "例句": "你要到哪裡去旅行？他們到臺灣學中文。"}, {"序號": "80", "語法點": "太Vs了", "等別": "基礎", "級別": "第2*級", "例句": "這家飯店太貴了，我不要住。"}, {"序號": "81", "語法點": "......還是......", "等別": "基礎", "級別": "第2*級", "例句": "爸爸今天晚上想吃飯還是吃麵？"}, {"序號": "82", "語法點": "又......又......", "等別": "基礎", "級別": "第2*級", "例句": "這家餐廳又便宜又有名。"}, {"序號": "83", "語法點": "有（一）點Vs", "等別": "基礎", "級別": "第2*級", "例句": "我有一點累。今天有一點冷。"}, {"序號": "84", "語法點": "（在） PW 的 N", "等別": "基礎", "級別": "第2*級", "例句": "在桌上的電腦是我弟弟的。"}, {"序號": "85", "語法點": "從2", "等別": "基礎", "級別": "第2*級", "例句": "從早上開始，郵局排隊的人就很多。"}, {"序號": "86", "語法點": "V起來1", "等別": "基礎", "級別": "第2*級", "例句": "他站起來走出房間。"}, {"序號": "87", "語法點": "Vs一點", "等別": "基礎", "級別": "第2*級", "例句": "搬家的時候要小心一點。"}, {"序號": "88", "語法點": "數詞+多（量詞）", "等別": "基礎", "級別": "第2*級", "例句": "他們聊天聊了一個多小時。"}, {"序號": "89", "語法點": "V到1", "等別": "基礎", "級別": "第2*級", "例句": "王美美今天上課上到下午五點。"}, {"序號": "90", "語法點": "又1", "等別": "基礎", "級別": "第2*級", "例句": "他又忘了寫功課。"}, {"序號": "91", "語法點": "又2", "等別": "基礎", "級別": "第2*級", "例句": "他去了臺中，又去了高雄。他買了一件衣服，又買了一條褲子。"}, {"序號": "92", "語法點": "V過來1/過去", "等別": "基礎", "級別": "第2*級", "例句": "小孩笑著向我跑過來。我在這邊停車，你可以先走過去找朋友。"}, {"序號": "93", "語法點": "V下來/下去1", "等別": "基礎", "級別": "第2*級", "例句": "大家到了可以找地方坐下來休息。你可以從10樓走下去嗎？"}, {"序號": "94", "語法點": "A比B ......", "等別": "基礎", "級別": "第2*級", "例句": "弟弟比哥哥高。"}, {"序號": "95", "語法點": "A跟B一樣......", "等別": "基礎", "級別": "第2*級", "例句": "這本書跟那本書一樣貴。"}, {"序號": "96", "語法點": "一......就......", "等別": "基礎", "級別": "第2*級", "例句": "他們一下課就回家。"}, {"序號": "97", "語法點": "（是）......的", "等別": "基礎", "級別": "第2*級", "例句": "我是從美國來的。"}, {"序號": "98", "語法點": "好/難+V", "等別": "基礎", "級別": "第2*級", "例句": "這個字很難寫。三明治很好做。"}, {"序號": "99", "語法點": "了......就......", "等別": "基礎", "級別": "第2*級", "例句": "我吃了早飯就去上課。"}, {"序號": "100", "語法點": "從......往......", "等別": "基礎", "級別": "第2*級", "例句": "從學校往圖書館走就到了。"}, {"序號": "101", "語法點": "A離B......", "等別": "基礎", "級別": "第2*級", "例句": "我家離學校走路只要十分鐘。"}, {"序號": "102", "語法點": "VP 的 N", "等別": "基礎", "級別": "第2*級", "例句": "我認識一位會說德文的英文老師。"}, {"序號": "103", "語法點": "多+Vs？", "等別": "基礎", "級別": "第2*級", "例句": "你哥哥多高？"}, {"序號": "104", "語法點": "V進/出/上/回+（......）來/去", "等別": "基礎", "級別": "第2*級", "例句": "電梯等太久了，我從二樓走上來。你可以從這條路走上去就到了。你說的書我買回來了。照片洗好了，你可以拿回去了。衣服拿進來吧，外面好像快下雨了。我帶回了一個禮物（來）。他走進去書店，買了三本書。李明華走進郵局寄信（去）。弟弟從教室跑出來。老師說先休息十分鐘，大家就跑出去玩了。"}, {"序號": "105", "語法點": "零代詞", "等別": "基礎", "級別": "第2*級", "例句": "他看了菜單後，決定點一份三明治。"}, {"序號": "106", "語法點": "概數", "等別": "基礎", "級別": "第2*級", "例句": "A：你吃了幾個餃子？B：十幾個。"}, {"序號": "107", "語法點": "話題優先", "等別": "基礎", "級別": "第2*級", "例句": "筆，幾塊錢一枝呢？"}, {"序號": "108", "語法點": "V過2", "等別": "基礎", "級別": "第3級", "例句": "我今天早上已經看過電視新聞了。"}, {"序號": "109", "語法點": "V著2", "等別": "基礎", "級別": "第3級", "例句": "他們吃著餅乾看電視。"}, {"序號": "110", "語法點": "V到3", "等別": "基礎", "級別": "第3級", "例句": "他找到那家超市了。"}, {"序號": "111", "語法點": "才1", "等別": "基礎", "級別": "第3級", "例句": "他看了報告後才同意醫生的說法。"}, {"序號": "112", "語法點": "才4", "等別": "基礎", "級別": "第3級", "例句": "我上次見到你的時候，你才十一歲。"}, {"序號": "113", "語法點": "讓1", "等別": "基礎", "級別": "第3級", "例句": "睡前喝杯熱牛奶，可以讓我睡得更好。"}, {"序號": "114", "語法點": "讓2", "等別": "基礎", "級別": "第3級", "例句": "能不能讓我在這兒坐著休息一下？"}, {"序號": "115", "語法點": "叫1", "等別": "基礎", "級別": "第3級", "例句": "老闆叫我下午跟他一起去開會。"}, {"序號": "116", "語法點": "叫2", "等別": "基礎", "級別": "第3級", "例句": "我叫人去買便當回來。"}, {"序號": "117", "語法點": "呢2", "等別": "基礎", "級別": "第3級", "例句": "你什麼時候可以開始工作呢？"}, {"序號": "118", "語法點": "沒（有）2", "等別": "基礎", "級別": "第3級", "例句": "你們參觀過校園沒有？"}, {"序號": "119", "語法點": "必須", "等別": "基礎", "級別": "第3級", "例句": "這場會議很重要，你必須準時參加。"}, {"序號": "120", "語法點": "到", "等別": "基礎", "級別": "第3級", "例句": "三年級到六年級的同學，下課後都要留下來練習跳舞。"}, {"序號": "121", "語法點": "要是......就......", "等別": "基礎", "級別": "第3級", "例句": "你要是發燒，今天就在家休息吧。"}, {"序號": "122", "語法點": "......的話", "等別": "基礎", "級別": "第3級", "例句": "下雨的話，我就不去了。"}, {"序號": "123", "語法點": "A沒有B（這/那麼）...... ", "等別": "基礎", "級別": "第3級", "例句": "事情沒有你想的那麼嚴重。這盤豆腐吃起來沒有炒麵這麼辣。"}, {"序號": "124", "語法點": "不但......而且......", "等別": "基礎", "級別": "第3級", "例句": "這個故事不但容易了解， 而且很有意思。"}, {"序號": "125", "語法點": "不但......還/也......", "等別": "基礎", "級別": "第3級", "例句": "在超商不但可以買東西還可以寄東西。林先生不但是個好老師，也是一位好父親。"}, {"序號": "126", "語法點": "而且", "等別": "基礎", "級別": "第3級", "例句": "臺灣夏天很熱，而且很濕。"}, {"序號": "127", "語法點": "真Vs", "等別": "基礎", "級別": "第3級", "例句": "那個房子真不錯，而且就在學校附近。"}, {"序號": "128", "語法點": "越......越......", "等別": "基礎", "級別": "第3級", "例句": "颱風來了，雨越下越大。"}, {"序號": "129", "語法點": "越來越......", "等別": "基礎", "級別": "第3級", "例句": "他的中文越來越好了。"}, {"序號": "130", "語法點": "本來", "等別": "基礎", "級別": "第3級", "例句": "我們本來不認識，後來聊了一下就熟了。"}, {"序號": "131", "語法點": "然後", "等別": "基礎", "級別": "第3級", "例句": "我喜歡先吃菜再吃肉，然後才吃飯。"}, {"序號": "132", "語法點": "一邊......一邊......", "等別": "基礎", "級別": "第3級", "例句": "他一邊吃飯一邊看手機。"}, {"序號": "133", "語法點": "先......再......", "等別": "基礎", "級別": "第3級", "例句": "大家先找位子再點菜。"}, {"序號": "134", "語法點": "就要......了", "等別": "基礎", "級別": "第3級", "例句": "下個星期就要開學了。"}, {"序號": "135", "語法點": "快要......了", "等別": "基礎", "級別": "第3級", "例句": "暑假快要結束了。"}, {"序號": "136", "語法點": "V一下", "等別": "基礎", "級別": "第3級", "例句": "我帶你去附近的圖書館參觀一下。"}, {"序號": "137", "語法點": "（當）......的時候", "等別": "基礎", "級別": "第3級", "例句": "他生氣的時候，最好不要跟他開玩笑。"}, {"序號": "138", "語法點": "V上", "等別": "基礎", "級別": "第3級", "例句": "他剛剛又走上樓，不知去拿什麼東西。"}, {"序號": "139", "語法點": "V下", "等別": "基礎", "級別": "第3級", "例句": "他們選了一個離門口最近的位子坐下。"}, {"序號": "140", "語法點": "V起", "等別": "基礎", "級別": "第3級", "例句": "他拿起筆寫下電話和地址。"}, {"序號": "141", "語法點": "V滿", "等別": "基礎", "級別": "第3級", "例句": "公車上站滿了人。"}, {"序號": "142", "語法點": "（也）......也......", "等別": "基礎", "級別": "第3級", "例句": "草莓可以做果汁也可以做蛋糕。這個地點可以做生意也可以租人。"}, {"序號": "143", "語法點": "有時候......有時候......", "等別": "基礎", "級別": "第3級", "例句": "百貨公司的活動有時候是打折，有時候是送禮物。"}, {"序號": "144", "語法點": "對", "等別": "基礎", "級別": "第3級", "例句": "李小姐聽到消息後，開心地對我笑了笑。"}, {"序號": "145", "語法點": "對......有興趣", "等別": "基礎", "級別": "第3級", "例句": "他對畫畫很有興趣，以後想當畫家。"}, {"序號": "146", "語法點": "替", "等別": "基礎", "級別": "第3級", "例句": "你可以替我把禮物包起來嗎？"}, {"序號": "147", "語法點": "為了", "等別": "基礎", "級別": "第3級", "例句": "他為了學中文到臺灣來。為了賺更多錢，他打了好幾份工。"}, {"序號": "148", "語法點": "動詞重疊（ABAB）", "等別": "基礎", "級別": "第3級", "例句": "寒假要去哪裡玩，我們可以一起討論討論。"}, {"序號": "149", "語法點": "狀態動詞重疊做謂語AA/AABB", "等別": "基礎", "級別": "第3級", "例句": "我的室友眼睛大大的，頭髮長長的。他每天都穿得漂漂亮亮的。"}, {"序號": "150", "語法點": "狀態動詞重疊做定語", "等別": "基礎", "級別": "第3級", "例句": "這間店的蛋糕很有名，總在短短的時間內就賣完了。"}, {"序號": "151", "語法點": "狀態動詞重疊做狀語", "等別": "基礎", "級別": "第3級", "例句": "安安靜靜地坐著。好好地休息。"}, {"序號": "152", "語法點": "VV看", "等別": "基礎", "級別": "第3級", "例句": "這個麵包很好吃，你吃吃看。"}, {"序號": "153", "語法點": "還沒（有）", "等別": "基礎", "級別": "第3級", "例句": "我還沒給你剛剛買火車票的錢。我才剛回國，現在還沒有時間跟妹妹見面。"}, {"序號": "154", "語法點": "不太/不很", "等別": "基礎", "級別": "第3級", "例句": "你住的地方不太好找，我花了一點時間才找到。我的位子離老師太遠了，所以聽得不很清楚。"}, {"序號": "155", "語法點": "不用/不必", "等別": "基礎", "級別": "第3級", "例句": "他在外面租了房子，這學期不用再住在學校了。我有一個背包，所以不必帶行李箱。"}, {"序號": "156", "語法點": "是不是+VP", "等別": "基礎", "級別": "第3級", "例句": "你臉色不太好，是不是生病了？"}, {"序號": "157", "語法點": "好不好", "等別": "基礎", "級別": "第3級", "例句": "我們選個地點，開店做生意好不好？"}, {"序號": "158", "語法點": "好+幾/多/些+量詞", "等別": "基礎", "級別": "第3級", "例句": "他很喜歡吃餃子，每次都吃好幾盤。我認識他已經有好多年了。爸爸已經出國好些天了，應該快回來了。"}, {"序號": "159", "語法點": "結構助詞「地」", "等別": "基礎", "級別": "第3級", "例句": "他慢慢地走。"}, {"序號": "160", "語法點": "不知道......", "等別": "基礎", "級別": "第3級", "例句": "不知道明天早上六點能不能起得來。"}, {"序號": "161", "語法點": "那麼", "等別": "基礎", "級別": "第3級", "例句": "如果你不同意，那麼你建議我們該怎麼做呢？"}, {"序號": "162", "語法點": "那", "等別": "基礎", "級別": "第3級", "例句": "A：冰箱裡的東西都可以自己拿來吃。B：謝謝，那我就不客氣了。"}, {"序號": "163", "語法點": "（請）別", "等別": "基礎", "級別": "第3級", "例句": "下了飛機以後，別忘了打個電話。"}, {"序號": "164", "語法點": "（請）+VP", "等別": "基礎", "級別": "第3級", "例句": "去洗手！來這裡排隊！請小心開車！保持安靜！"}, {"序號": "165", "語法點": "還是......吧", "等別": "基礎", "級別": "第3級", "例句": "現在排隊的人太多了，我們還是等一下再來吧！"}, {"序號": "166", "語法點": "應該1", "等別": "基礎", "級別": "第3*級", "例句": "運動後應該把汗擦乾。"}, {"序號": "167", "語法點": "應該2", "等別": "基礎", "級別": "第3*級", "例句": "作業應該準時交給老師。"}, {"序號": "168", "語法點": "可以3", "等別": "基礎", "級別": "第3*級", "例句": "游泳可以讓身體更健康。"}, {"序號": "169", "語法點": "V起來2", "等別": "基礎", "級別": "第3*級", "例句": "他一聽到消息就開心地笑起來。"}, {"序號": "170", "語法點": "V起來3", "等別": "基礎", "級別": "第3*級", "例句": "夏天到了，冬天的衣服可以收起來了。"}, {"序號": "171", "語法點": "V下去2", "等別": "基礎", "級別": "第3*級", "例句": "時間到了，我不能再說下去了。"}, {"序號": "172", "語法點": "才2", "等別": "基礎", "級別": "第3*級", "例句": "學語言要多練習，才能學得好。"}, {"序號": "173", "語法點": "才3", "等別": "基礎", "級別": "第3*級", "例句": "他才出門，就開始下雨了。"}, {"序號": "174", "語法點": "就2", "等別": "基礎", "級別": "第3*級", "例句": "這條街有很多銀行，光這個路口就有四家。"}, {"序號": "175", "語法點": "還1", "等別": "基礎", "級別": "第3*級", "例句": "這家餐廳的水比飲料還貴。"}, {"序號": "176", "語法點": "願意", "等別": "基礎", "級別": "第3*級", "例句": "如果有適合的工作，你願意接受嗎？"}, {"序號": "177", "語法點": "只要......就......", "等別": "基礎", "級別": "第3*級", "例句": "他只要有空，就會去參加這次的派對。"}, {"序號": "178", "語法點": "只有......才......", "等別": "基礎", "級別": "第3*級", "例句": "你只有在學中文的環境才學得好。"}, {"序號": "179", "語法點": "只好", "等別": "基礎", "級別": "第3*級", "例句": "外面下起了大雨，我們只好留在飯店裡。"}, {"序號": "180", "語法點": "不管......都......", "等別": "基礎", "級別": "第3*級", "例句": "如果你有問題 ，不管什麼時候都可以打電話給我。"}, {"序號": "181", "語法點": "一M比一M......", "等別": "基礎", "級別": "第3*級", "例句": "秋天到了，天氣開始一天比一天冷。"}, {"序號": "182", "語法點": "Vs得多", "等別": "基礎", "級別": "第3*級", "例句": "他哥哥的年紀比他大得多。"}, {"序號": "183", "語法點": "尤其（是）", "等別": "基礎", "級別": "第3*級", "例句": "百貨公司常常有很多人，尤其是週末和假日。"}, {"序號": "184", "語法點": "V 得/不 了", "等別": "基礎", "級別": "第3*級", "例句": "這麼多東西你拿得了嗎？我一個人吃不了40個餃子。"}, {"序號": "185", "語法點": "V得/不......（表可能）", "等別": "基礎", "級別": "第3*級", "例句": "他看得懂中文菜單。我今天看不完這本書。"}, {"序號": "186", "語法點": "V 得/不 下", "等別": "基礎", "級別": "第3*級", "例句": "這個房間放得下沙發嗎？我的書包放不下這麼多書。"}, {"序號": "187", "語法點": "疑問代詞 ", "等別": "基礎", "級別": "第3*級", "例句": "這裡有很多位子，你想坐在哪裡都可以。"}, {"序號": "188", "語法點": "差不多", "等別": "基礎", "級別": "第3*級", "例句": "我們派對可以開始了，客人差不多都到了。"}, {"序號": "189", "語法點": "Vs極了/得不得了/得很", "等別": "基礎", "級別": "第3*級", "例句": "他終於買到演唱會的門票，心裡高興極了。這間店的空間雖然不大，但是每天生意都好得不得了。這個香蕉蛋糕的作法簡單得很。"}, {"序號": "190", "語法點": "Vs死了", "等別": "基礎", "級別": "第3*級", "例句": "學校裡的功課忙死了，下課還要去打工。"}, {"序號": "191", "語法點": "Vs壞了", "等別": "基礎", "級別": "第3*級", "例句": "他忙了一整天都沒吃東西，肚子餓壞了。"}, {"序號": "192", "語法點": "Vs了一點", "等別": "基礎", "級別": "第3*級", "例句": "雖然排隊的人多了一點，但這間店的牛肉麵非常有名。"}, {"序號": "193", "語法點": "把O V（一）V", "等別": "基礎", "級別": "第3*級", "例句": "今天天氣不錯，記得出門前把衣服洗一洗。"}, {"序號": "194", "語法點": "把 O V到......（來/去）", "等別": "基礎", "級別": "第3*級", "例句": "請你把車開到停車場。媽媽把傘送到學校來。弟弟把大衣拿到洗衣店去。"}, {"序號": "195", "語法點": "把 O V 了", "等別": "基礎", "級別": "第3*級", "例句": "這件衣服穿不下，我打算把它賣了。"}, {"序號": "196", "語法點": "把......V+結果補語", "等別": "基礎", "級別": "第3*級", "例句": "他把菜洗好了。"}, {"序號": "197", "語法點": "把 O V-在 PW", "等別": "基礎", "級別": "第3*級", "例句": "我把書放在桌子上。"}, {"序號": "198", "語法點": "把+N1+V給+N2", "等別": "基礎", "級別": "第3*級", "例句": "回家後再麻煩你把郵件寄給我。"}, {"序號": "199", "語法點": "被+（N）+V得", "等別": "基礎", "級別": "第3*級", "例句": "鄰居的聲音太大了，妹妹被吵得睡不著。"}, {"序號": "200", "語法點": "其實", "等別": "基礎", "級別": "第3*級", "例句": "一個禮拜運動兩次，其實不難。"}, {"序號": "201", "語法點": "什麼都......就是......", "等別": "基礎", "級別": "第3*級", "例句": "他什麼都吃，就是不敢吃臭豆腐。"}, {"序號": "202", "語法點": "V好", "等別": "基礎", "級別": "第3*級", "例句": "颱風快來了，媽媽把食物跟水都先買好了。"}, {"序號": "203", "語法點": "V完", "等別": "基礎", "級別": "第3*級", "例句": "他剛去市場買完菜。"}, {"序號": "204", "語法點": "VP+VP(連動)", "等別": "基礎", "級別": "第3*級", "例句": "我要回家吃飯了。"}, {"序號": "205", "語法點": "才......就......", "等別": "基礎", "級別": "第3*級", "例句": "我跟他才談沒多久，他就有事先離開了。"}, {"序號": "206", "語法點": "時段+否定", "等別": "基礎", "級別": "第3*級", "例句": "他兩天沒睡覺了，讓他多睡一點。"}, {"序號": "207", "語法點": "從......起", "等別": "基礎", "級別": "第3*級", "例句": "從現在起，你應該多吃菜少吃肉。"}, {"序號": "208", "語法點": "V  得/不 起", "等別": "基礎", "級別": "第3*級", "例句": "這支手錶現在在打折，一般學生也買得起。"}, {"序號": "209", "語法點": "V （得/不）出來", "等別": "基礎", "級別": "第3*級", "例句": "從他說話的樣子來看，感覺不出來他很緊張。"}, {"序號": "210", "語法點": "V住", "等別": "基礎", "級別": "第3*級", "例句": "姐姐學一遍，就記住所有作法了。"}, {"序號": "211", "語法點": "V著（ㄓㄠˊ）", "等別": "基礎", "級別": "第3*級", "例句": "他喝完牛奶很快就睡著了。"}, {"序號": "212", "語法點": "V 得/不 動", "等別": "基礎", "級別": "第3*級", "例句": "你拿得動這些書架嗎？"}, {"序號": "213", "語法點": "V慣", "等別": "基礎", "級別": "第3*級", "例句": "他已經過慣了城市的生活，去鄉下常覺得不習慣。"}, {"序號": "214", "語法點": "V掉", "等別": "基礎", "級別": "第3*級", "例句": "今天生意很好，一下子就賣掉了四雙皮鞋。"}, {"序號": "215", "語法點": "V個不停/沒完", "等別": "基礎", "級別": "第3*級", "例句": "他很喜歡跳舞，每次聽到音樂就跳個不停。他對旅遊很有興趣，每次一講都講個沒完。"}, {"序號": "216", "語法點": "V個夠", "等別": "基礎", "級別": "第3*級", "例句": "這次演唱會一共有三十首歌，你可以一次聽個夠。"}, {"序號": "217", "語法點": "PW+V（存現）", "等別": "基礎", "級別": "第3*級", "例句": "餐桌上放著很多新鮮的水果。"}, {"序號": "218", "語法點": "會......的", "等別": "基礎", "級別": "第3*級", "例句": "長大後，人的想法是會改變的。"}, {"序號": "219", "語法點": "（連）....../一......都/也+不/沒......", "等別": "基礎", "級別": "第3*級", "例句": "我連家旁邊開了一間健身房都不知道。畢業後，我們一次也沒見過。"}, {"序號": "220", "語法點": "不是......就是......", "等別": "基礎", "級別": "第3*級", "例句": "他週末不是打籃球，就是去慢跑。"}, {"序號": "221", "語法點": "V（了）（一）V", "等別": "基礎", "級別": "第3*級", "例句": "王小姐高興地笑了笑。"}, {"序號": "222", "語法點": "一M一M ......", "等別": "基礎", "級別": "第3*級", "例句": "他們一步一步爬上去。"}, {"序號": "223", "語法點": "不再......了", "等別": "基礎", "級別": "第3*級", "例句": "找到工作後，他現在不再擔心錢的問題了。"}, {"序號": "224", "語法點": "一點也/都+不/沒", "等別": "基礎", "級別": "第3*級", "例句": "年輕時，整晚不睡一點都不累。我昨晚一點酒也沒喝。"}, {"序號": "225", "語法點": "從來+不/沒......", "等別": "基礎", "級別": "第3*級", "例句": "李明華從來沒搭過飛機。"}, {"序號": "226", "語法點": "不/沒+嗎", "等別": "基礎", "級別": "第3*級", "例句": "你今天怎麼那麼早就回家了，你不舒服嗎？你怎麼站在外面，你沒帶鑰匙嗎？"}, {"序號": "227", "語法點": "不是/沒......嗎", "等別": "基礎", "級別": "第3*級", "例句": "如果參加活動可以認識更多人，這樣不是很好嗎？你怎麼還在家裡，王美美沒跟你說改時間了嗎？"}, {"序號": "228", "語法點": "......QW......就......QW......", "等別": "基礎", "級別": "第3*級", "例句": "這次作文沒有題目，你想寫什麼就寫什麼。"}, {"序號": "229", "語法點": "其中", "等別": "基礎", "級別": "第3*級", "例句": "他們兩兄弟，其中一個適合做生意，一個適合教書。"}, {"序號": "230", "語法點": "等/等等", "等別": "基礎", "級別": "第3*級", "例句": "他很喜歡吃甜食，像是巧克力、蛋糕、冰淇淋等。"}, {"序號": "231", "語法點": "以+上/下/內/外", "等別": "基礎", "級別": "第3*級", "例句": "他每天通車要花費兩個小時以上。在臺灣，十八歲以下不能買酒。妳可以選一個一千元以內的禮物。他摔到五公尺以外的草地。"}, {"序號": "232", "語法點": "除了......（以外），......都......", "等別": "基礎", "級別": "第3*級", "例句": "除了牛肉以外，其他的肉我都可以吃。"}, {"序號": "233", "語法點": "除了......以外， 還/也......", "等別": "基礎", "級別": "第3*級", "例句": "這次的活動除了杯子以外，還送毛巾。除了我以外，還有十幾位同學也收到了一樣的郵件。"}, {"序號": "234", "語法點": "數+（量詞）+左右", "等別": "基礎", "級別": "第3*級", "例句": "他每天搭車上班的時間需要一個小時左右。"}, {"序號": "235", "語法點": "百分數", "等別": "基礎", "級別": "第3*級", "例句": "這裡只有百分之五的人沒出過國。"}, {"序號": "236", "語法點": "倍數", "等別": "基礎", "級別": "第3*級", "例句": "姐姐的行李是我的兩倍重。"}, {"序號": "237", "語法點": "分數", "等別": "基礎", "級別": "第3*級", "例句": "這條腳踏車步道他大概只騎了三分之一。"}, {"序號": "238", "語法點": "四則運算", "等別": "基礎", "級別": "第3*級", "例句": "1+2=3 一加二等於三3-2=1 三減二等於一3×2=6 三乘以二等於六8÷4=2 八除以四等於二"}, {"序號": "239", "語法點": "小數點", "等別": "基礎", "級別": "第3*級", "例句": "3.254 三點二五四"}, {"序號": "240", "語法點": "VP/S+的......", "等別": "基礎", "級別": "第3*級", "例句": "這本書討論的是美洲的歷史。"}, {"序號": "241", "語法點": "別（再）......了", "等別": "基礎", "級別": "第3*級", "例句": "別再說話了，比賽要開始囉！"}, {"序號": "242", "語法點": "可1", "等別": "進階", "級別": "第4級", "例句": "一般民眾不可免費使用本校的游泳池。"}, {"序號": "243", "語法點": "可2", "等別": "進階", "級別": "第4級", "例句": "他不但可理解老師上課的內容，還能說出重點。"}, {"序號": "244", "語法點": "可3", "等別": "進階", "級別": "第4級", "例句": "做好資源回收可改善環境。"}, {"序號": "245", "語法點": "該1", "等別": "進階", "級別": "第4級", "例句": "我們平常不該吃太鹹的食物。"}, {"序號": "246", "語法點": "該2", "等別": "進階", "級別": "第4級", "例句": "時間不早了，我該回家了。"}, {"序號": "247", "語法點": "V出2", "等別": "進階", "級別": "第4級", "例句": "在重要時刻他總能提出有用的想法或辦法。"}, {"序號": "248", "語法點": "還3", "等別": "進階", "級別": "第4級", "例句": "他白天上班，晚上還當家教，根本沒時間回信。"}, {"序號": "249", "語法點": "V起來4", "等別": "進階", "級別": "第4級", "例句": "你今天看起來很累。"}, {"序號": "250", "語法點": "不能不/不得不/不可不", "等別": "進階", "級別": "第4級", "例句": "流了一整天的汗，我的衣服不能不洗。他要搬家了，所以不得不轉學。日常生活中，我們對吃的東西不可不小心。"}, {"序號": "251", "語法點": "跟/和......比起來", "等別": "進階", "級別": "第4級", "例句": "跟在國內讀書比起來，出國留學是更大的挑戰。"}, {"序號": "252", "語法點": "A像B一樣......", "等別": "進階", "級別": "第4級", "例句": "畢業後，我們不再像以前一樣經常見面。"}, {"序號": "253", "語法點": "A不如B", "等別": "進階", "級別": "第4級", "例句": "最近幾年，火車站附近的發展不如新市區。"}, {"序號": "254", "語法點": "多Vs啊", "等別": "進階", "級別": "第4級", "例句": "他的新髮型多漂亮啊！"}, {"序號": "255", "語法點": "差一點（就）......", "等別": "進階", "級別": "第4級", "例句": "他差一點就遲到了。"}, {"序號": "256", "語法點": "跟......（沒）有關", "等別": "進階", "級別": "第4級", "例句": "現代人生病往往都跟壓力有關。一個人會不會賺錢跟年紀沒太大關係。"}, {"序號": "257", "語法點": "給......帶來......", "等別": "進階", "級別": "第4級", "例句": "持續工作可以給我們帶來穩定的收入。"}, {"序號": "258", "語法點": "不......不......", "等別": "進階", "級別": "第4級", "例句": "你不來，活動就不能開始。"}, {"序號": "259", "語法點": "看/要看/得看", "等別": "進階", "級別": "第4級", "例句": "遇到問題時，要看每個人用什麼態度去面對它，處理方式就會不一樣。明天能不能去野餐還得看天氣才能決定。"}, {"序號": "260", "語法點": "不論/無論", "等別": "進階", "級別": "第4級", "例句": "近年來不論是企業或個人，使用網路的情況都越來越普遍。無論是開車出門或到餐廳吃飯，我都會選擇人少的時間去。"}, {"序號": "261", "語法點": "只是", "等別": "進階", "級別": "第4級", "例句": "他身體很健康，只是眼睛不太好。"}, {"序號": "262", "語法點": "卻", "等別": "進階", "級別": "第4級", "例句": "外面太陽很大，但溫度卻很低。"}, {"序號": "263", "語法點": "（要）不然", "等別": "進階", "級別": "第4級", "例句": "爸爸叫我們動作快，（要）不然船要開走了。"}, {"序號": "264", "語法點": "是", "等別": "進階", "級別": "第4級", "例句": "A：出版旅遊雜誌要花不少錢吧！B：（出版旅遊雜誌的）成本是很高。"}, {"序號": "265", "語法點": "哪裡......", "等別": "進階", "級別": "第4級", "例句": "他本來打算去租影片，哪裡知道那間店在三天前竟然關了！"}, {"序號": "266", "語法點": "說......就......", "等別": "進階", "級別": "第4級", "例句": "山上的天氣不太穩定，常常說變就變。"}, {"序號": "267", "語法點": "通過", "等別": "進階", "級別": "第4級", "例句": "通過這次溝通，老師又更理解學生的想法了。"}, {"序號": "268", "語法點": "經過", "等別": "進階", "級別": "第4級", "例句": "經過一段時間之後，他已經可以適應研究所的生活了。"}, {"序號": "269", "語法點": "拿", "等別": "進階", "級別": "第4級", "例句": "上課的時候，老師常常拿自己的經驗來作例子。"}, {"序號": "270", "語法點": "按照", "等別": "進階", "級別": "第4級", "例句": "他們按照旅遊書上的介紹，安排了三天兩夜的旅行。"}, {"序號": "271", "語法點": "照（著）", "等別": "進階", "級別": "第4級", "例句": "我照著媽媽的做法包水餃。"}, {"序號": "272", "語法點": "趁（著）", "等別": "進階", "級別": "第4級", "例句": "趁著年節的時候，爸爸拜訪了很多親戚。趁飯菜還熱著時，趕緊先來吃吧。"}, {"序號": "273", "語法點": "離", "等別": "進階", "級別": "第4級", "例句": "離過年只剩兩天了，火車票幾乎全賣完了。"}, {"序號": "274", "語法點": "V著V著......就......了", "等別": "進階", "級別": "第4級", "例句": "弟弟常常在床上看書，看著看著就睡著了。"}, {"序號": "275", "語法點": "早就......了", "等別": "進階", "級別": "第4級", "例句": "說點別的吧，這個故事他早就聽過了。"}, {"序號": "276", "語法點": "......以內/之內", "等別": "進階", "級別": "第4級", "例句": "網站的使用人數在一天之內就增加了十倍。每個人都要在會議上做一個十分鐘以內的報告。"}, {"序號": "277", "語法點": "一會兒......，一會兒......", "等別": "進階", "級別": "第4級", "例句": "他一個人就扮演了四、五個角色，一會兒是公車司機，一會兒是老闆。"}, {"序號": "278", "語法點": "一下......一下......", "等別": "進階", "級別": "第4級", "例句": "春天的天氣一下冷、一下熱，很容易讓人感冒。"}, {"序號": "279", "語法點": "既......又......", "等別": "進階", "級別": "第4級", "例句": "這家賣的水果既新鮮又好吃。"}, {"序號": "280", "語法點": "一V起", "等別": "進階", "級別": "第4級", "例句": "一聊起喜歡的食物，人們都變得十分感興趣。"}, {"序號": "281", "語法點": "V起N（來）", "等別": "進階", "級別": "第4級", "例句": "他最不愛上學，現在竟然當起老師來了。"}, {"序號": "282", "語法點": "V光", "等別": "進階", "級別": "第4級", "例句": "你回來的路上可以買條吐司嗎？家裡的吐司都吃光了。"}, {"序號": "283", "語法點": "因為......的關係", "等別": "進階", "級別": "第4級", "例句": "因為工作的關係，哥哥手機常常關機，所以很難聯絡到他。"}, {"序號": "284", "語法點": "另外", "等別": "進階", "級別": "第4級", "例句": "這間餐廳環境很不錯，另外還提供兒童免費的遊戲空間。"}, {"序號": "285", "語法點": "再加上", "等別": "進階", "級別": "第4級", "例句": "哥哥現在工作穩定，再加上之前存的錢，所以日子過得還不錯。"}, {"序號": "286", "語法點": "不只......而且/還/也......", "等別": "進階", "級別": "第4級", "例句": "這個杯子的設計不只好看而且還很方便。這輛車不只便宜，還很好開。這種餅乾很好吃，不只小孩喜歡，大人也喜歡。"}, {"序號": "287", "語法點": "除了......之外......", "等別": "進階", "級別": "第4級", "例句": "姐姐平常除了喝水之外，不喝其他的飲料。"}, {"序號": "288", "語法點": "像......什麼的", "等別": "進階", "級別": "第4級", "例句": "臺灣有些食物，像臭豆腐、大腸麵線、豬血糕什麼的，都是以前我沒吃過的。"}, {"序號": "289", "語法點": "......而已", "等別": "進階", "級別": "第4級", "例句": "第一次上課的內容只不過是教一些基本動作而已。"}, {"序號": "290", "語法點": "以+內/外/左/右/東/西/南/北（位置）", "等別": "進階", "級別": "第4級", "例句": "捷運站黃線以內的範圍不能吃東西。這條河以東。和平東路以西。"}, {"序號": "291", "語法點": "說到/談到/講到", "等別": "進階", "級別": "第4級", "例句": "談到資訊設備，這間圖書館的電腦都是最新的。說到夢想，大家有各式各樣的回答。"}, {"序號": "292", "語法點": "拿......來說", "等別": "進階", "級別": "第4級", "例句": "拿臺灣來說，現在的老年人口越來越多，出生率卻越來越低。"}, {"序號": "293", "語法點": "對......來說", "等別": "進階", "級別": "第4級", "例句": "對幼兒來說，遊戲就是他生活中最重要的事。"}, {"序號": "294", "語法點": "不是", "等別": "進階", "級別": "第4級", "例句": "這句話的意思不是很清楚，可以說明一下嗎？他們的意見我不是很同意。"}, {"序號": "295", "語法點": "不到", "等別": "進階", "級別": "第4級", "例句": "身高不到九十公分的兒童可以免費入場。"}, {"序號": "296", "語法點": "怎麼（一）回事", "等別": "進階", "級別": "第4級", "例句": "聽說姐姐跟室友吵架了，你知道是怎麼一回事嗎？"}, {"序號": "297", "語法點": "量詞重疊", "等別": "進階", "級別": "第4級", "例句": "今年的玫瑰花朵朵都開得很好。"}, {"序號": "298", "語法點": "害", "等別": "進階", "級別": "第4級", "例句": "他忘了帶手機，害我一整天都找不到他。"}, {"序號": "299", "語法點": "把 ......V成......", "等別": "進階", "級別": "第4級", "例句": "請你把英文翻成中文。"}, {"序號": "300", "語法點": "把......V作/做......", "等別": "進階", "級別": "第4級", "例句": "爺爺把旅行當作退休之後最重要的活動。"}, {"序號": "301", "語法點": "被......V作/做......", "等別": "進階", "級別": "第4級", "例句": "他被鄰居當作小偷。"}, {"序號": "302", "語法點": "被......V成......", "等別": "進階", "級別": "第4級", "例句": "他被人打成重傷。"}, {"序號": "303", "語法點": "賓+受（N）+V", "等別": "進階", "級別": "第4級", "例句": "今年香蕉受產量影響，價格跌得很低。"}, {"序號": "304", "語法點": "一般來說", "等別": "進階", "級別": "第4級", "例句": "一般來說，收入越多，花費會越高。"}, {"序號": "305", "語法點": "你說", "等別": "進階", "級別": "第4級", "例句": "你說這麼晚了，他還會回來吃飯嗎？"}, {"序號": "306", "語法點": "看樣子", "等別": "進階", "級別": "第4級", "例句": "哥哥的身材很好，看樣子平時有運動的習慣。李明華今天精神很不集中，看樣子昨晚沒睡好。"}, {"序號": "307", "語法點": "誰知道", "等別": "進階", "級別": "第4級", "例句": "才下了一個鐘頭的雨，誰知道家裡就淹水了。"}, {"序號": "308", "語法點": "所以啦", "等別": "進階", "級別": "第4級", "例句": "A：演唱會的票都賣光了。B：所以啦，下次應該早點去排隊。"}, {"序號": "309", "語法點": "可4", "等別": "進階", "級別": "第4*級", "例句": "這間牛肉麵店可算是臺北最有名的了。"}, {"序號": "310", "語法點": "與1", "等別": "進階", "級別": "第4*級", "例句": "日月潭與阿里山都是臺灣有名的旅遊地點。"}, {"序號": "311", "語法點": "與2", "等別": "進階", "級別": "第4*級", "例句": "這位作家很喜歡與讀者分享生活的感動。"}, {"序號": "312", "語法點": "由1", "等別": "進階", "級別": "第4*級", "例句": "深夜山上的溫度由十度降到零度以下。"}, {"序號": "313", "語法點": "多少2", "等別": "進階", "級別": "第4*級", "例句": "他多少存了點錢，所以你不用擔心。"}, {"序號": "314", "語法點": "都2", "等別": "進階", "級別": "第4*級", "例句": "都提醒過幾次了，他還是忘記還書。"}, {"序號": "315", "語法點": "V去2", "等別": "進階", "級別": "第4*級", "例句": "他把名字從名單上除去。"}, {"序號": "316", "語法點": "V過來2", "等別": "進階", "級別": "第4*級", "例句": "父母用教育的方式把孩子不好的行為改過來。"}, {"序號": "317", "語法點": "還2", "等別": "進階", "級別": "第4*級", "例句": "這組沙發的價格還算便宜。"}, {"序號": "318", "語法點": "才5", "等別": "進階", "級別": "第4*級", "例句": "這麼短的裙子他才不敢穿呢！"}, {"序號": "319", "語法點": "A有B（這/那麼）......", "等別": "進階", "級別": "第4*級", "例句": "這間教室有一個籃球場這麼大。"}, {"序號": "320", "語法點": "比......來得 Vs", "等別": "進階", "級別": "第4*級", "例句": "弟弟的身高比同年紀的孩子來得高。"}, {"序號": "321", "語法點": "Vs得沒話說", "等別": "進階", "級別": "第4*級", "例句": "他們家姊妹的感情好得沒話說，幾乎從來沒有吵過架。"}, {"序號": "322", "語法點": "向", "等別": "進階", "級別": "第4*級", "例句": "我向爸爸借了一千塊。"}, {"序號": "323", "語法點": "為", "等別": "進階", "級別": "第4*級", "例句": "換工作有時會為你帶來新的機會。"}, {"序號": "324", "語法點": "既然......就......", "等別": "進階", "級別": "第4*級", "例句": "既然在學校上課，就可以利用時間好好使用學校的資源。"}, {"序號": "325", "語法點": "不/沒（有）......，就......", "等別": "進階", "級別": "第4*級", "例句": "沒有填寫信箱，申請就不會成功。不註冊，就無法選課。"}, {"序號": "326", "語法點": "再不......就......了", "等別": "進階", "級別": "第4*級", "例句": "我必須先離開了，再不走就要遲到了。"}, {"序號": "327", "語法點": "非......不（可）", "等別": "進階", "級別": "第4*級", "例句": "我開會快遲到了，現在非走不可了。"}, {"序號": "328", "語法點": "即使......也......", "等別": "進階", "級別": "第4*級", "例句": "即使大學畢業了，平時自己也要多學習新的知識。"}, {"序號": "329", "語法點": "就是......，也......", "等別": "進階", "級別": "第4*級", "例句": "如果運動對健康有幫助，就是花費多一點時間也是值得的。"}, {"序號": "330", "語法點": "再......也......", "等別": "進階", "級別": "第4*級", "例句": "他很喜歡彈鋼琴，所以平時練習再辛苦也不怕。"}, {"序號": "331", "語法點": "就算......也......", "等別": "進階", "級別": "第4*級", "例句": "就算沒有相機，手機也可以拍照。"}, {"序號": "332", "語法點": "除非", "等別": "進階", "級別": "第4*級", "例句": "除非你對教書很有興趣，否則很容易就會失去耐心。"}, {"序號": "333", "語法點": "否則", "等別": "進階", "級別": "第4*級", "例句": "快去叫醒爸爸，否則他上班要遲到了。"}, {"序號": "334", "語法點": "假如...... （就）......", "等別": "進階", "級別": "第4*級", "例句": "假如你吃不完的話，就當作下午的點心吧！假如你要去會場，記得可以先到服務臺拿講義。"}, {"序號": "335", "語法點": "倒（是）", "等別": "進階", "級別": "第4*級", "例句": "這間公司是值得投資的，至於投資多少倒是可以再討論。"}, {"序號": "336", "語法點": "寧願......也（不）要......", "等別": "進階", "級別": "第4*級", "例句": "他寧願少賺一點錢，也不要把時間都花在工作上。在國外，弟弟寧願多花些電話費，也要常常打電話回家。"}, {"序號": "337", "語法點": "寧可......也（不）要......", "等別": "進階", "級別": "第4*級", "例句": "我寧可少賺一點錢，也要有自己的休閒時間。我寧可多花一點錢買洗衣機，也不要再等到周年慶了。"}, {"序號": "338", "語法點": "居然", "等別": "進階", "級別": "第4*級", "例句": "他平時工作很忙，居然還有時間可以寫小說。"}, {"序號": "339", "語法點": "簡直", "等別": "進階", "級別": "第4*級", "例句": "一天寫好一篇論文，簡直是不可能的事。"}, {"序號": "340", "語法點": "反正", "等別": "進階", "級別": "第4*級", "例句": "借錢也好，先賺錢再讀書也好，反正他一定要念完大學。"}, {"序號": "341", "語法點": "幸虧", "等別": "進階", "級別": "第4*級", "例句": "他差點走錯路，幸虧停下來查了地圖。"}, {"序號": "342", "語法點": "難道......（嗎）", "等別": "進階", "級別": "第4*級", "例句": "我們是二十年的老朋友了，難道我還不了解你嗎？"}, {"序號": "343", "語法點": "算（是）", "等別": "進階", "級別": "第4*級", "例句": "這次的颱風算強颱，你一定要先準備好水跟食物。尖峰時刻竟然沒塞車，我們算是運氣很好。"}, {"序號": "344", "語法點": "難怪/怪不得", "等別": "進階", "級別": "第4*級", "例句": "果然是你，難怪我覺得聲音很熟悉。這座運動中心在半年前剛剛建好，怪不得這麼新。"}, {"序號": "345", "語法點": "果然", "等別": "進階", "級別": "第4*級", "例句": "爸爸忘了戴帽子出門，回來果然曬傷了。"}, {"序號": "346", "語法點": "竟（然）", "等別": "進階", "級別": "第4*級", "例句": "一個不到十歲的孩子，竟然會有這麼成熟的想法。"}, {"序號": "347", "語法點": "照V", "等別": "進階", "級別": "第4*級", "例句": "雖然他月底才搬進來，這個月的房租還是照付。"}, {"序號": "348", "語法點": "就是", "等別": "進階", "級別": "第4*級", "例句": "不管遇到什麼問題，他就是很有自信。"}, {"序號": "349", "語法點": "光N/V（O）就", "等別": "進階", "級別": "第4*級", "例句": "光從書名就知道這是一本很有創意的書。光聽就學會了。"}, {"序號": "350", "語法點": "根本", "等別": "進階", "級別": "第4*級", "例句": "他每天工作都很忙，根本沒時間與孩子們相處。"}, {"序號": "351", "語法點": "靠/靠著", "等別": "進階", "級別": "第4*級", "例句": "生活上有任何問題，我們都要努力靠自己的力量去解決。他習慣靠著閱讀放鬆心情。"}, {"序號": "352", "語法點": "根據", "等別": "進階", "級別": "第4*級", "例句": "根據氣象報告，明天下午會下雨。"}, {"序號": "353", "語法點": "......好......", "等別": "進階", "級別": "第4*級", "例句": "自己在國外生活，記得有空多打電話回家，好讓家人放心。"}, {"序號": "354", "語法點": "自從......後", "等別": "進階", "級別": "第4*級", "例句": "自從他的研究發表後，受到很多的肯定。"}, {"序號": "355", "語法點": "自從......以來", "等別": "進階", "級別": "第4*級", "例句": "自從開始學習網球以來，他的表現一直都很出色。"}, {"序號": "356", "語法點": "至今", "等別": "進階", "級別": "第4*級", "例句": "他講了一句話，至今仍讓我印象深刻。"}, {"序號": "357", "語法點": "原來A，如今B", "等別": "進階", "級別": "第4*級", "例句": "這塊地原來種香蕉，如今改種芒果。"}, {"序號": "358", "語法點": "一方面......，一方面......", "等別": "進階", "級別": "第4*級", "例句": "表演的時候，一方面要注意動作，一方面還要跟別人配合。"}, {"序號": "359", "語法點": "一面......一面......", "等別": "進階", "級別": "第4*級", "例句": "臺下的觀眾一面拍手，一面跟著唱。"}, {"序號": "360", "語法點": "千萬", "等別": "進階", "級別": "第4*級", "例句": "出國時，千萬要記得帶護照。"}, {"序號": "361", "語法點": "V中", "等別": "進階", "級別": "第4*級", "例句": "意外發生的原因目前仍在調查中。"}, {"序號": "362", "語法點": "結果", "等別": "進階", "級別": "第4*級", "例句": "他去很多家公司面試，結果只有一家公司通知他去上班。"}, {"序號": "363", "語法點": "由於", "等別": "進階", "級別": "第4*級", "例句": "表達能力差正是我的弱點，但由於多講多寫，這些弱點也就克服了。"}, {"序號": "364", "語法點": "因此", "等別": "進階", "級別": "第4*級", "例句": "這家麵店參加牛肉麵比賽得了第一名，因此吸引了更多顧客。"}, {"序號": "365", "語法點": "甚至（於）", "等別": "進階", "級別": "第4*級", "例句": "妹妹很怕黑，甚至連晚上睡覺都要開燈。"}, {"序號": "366", "語法點": "任何", "等別": "進階", "級別": "第4*級", "例句": "做任何重大的決定以前，都應該要經過仔細的思考。"}, {"序號": "367", "語法點": "以上", "等別": "進階", "級別": "第4*級", "例句": "由以上的報告，我們可以知道不同地區學生的學習差異。"}, {"序號": "368", "語法點": "（在）......方面", "等別": "進階", "級別": "第4*級", "例句": "除了運動，爸爸在飲食方面也非常注意。"}, {"序號": "369", "語法點": "關於", "等別": "進階", "級別": "第4*級", "例句": "張老師寫了一篇關於梵谷作品欣賞的文章。"}, {"序號": "370", "語法點": "以/從......來看", "等別": "進階", "級別": "第4*級", "例句": "得到這份工作的時候，我覺得以薪水來看，算是相當不錯。從穩定性來看，這間公司值得投資。"}, {"序號": "371", "語法點": "V 得/不 來", "等別": "進階", "級別": "第4*級", 